{
  "manifest_version": 3,
  "name": "Memory Wallet",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Your AI memory. Your rules. A local memory wallet that ChatGPT and Claude can only read with your permission. Nothing leaves your device.",
  "permissions": ["storage", "scripting", "offscreen"],
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Memory Wallet — Your AI memory. Your rules."
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}











